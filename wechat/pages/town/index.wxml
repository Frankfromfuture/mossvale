<view class="page">
 <view class="heading"><text class="title">日子慢慢，故事发生。</text><text class="sub">春日 · 第 {{day}} 天 · {{clock}}</text></view>
 <view wx:if="error" class="error">{{error}}</view>
 <block wx:if="world">
  <view class="map"><image src="{{apiBase}}/assets/town.png" mode="aspectFill" class="map-image"/><view wx:for="{{world.residents}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" class="person {{selected===item.id?'selected':''}}" style="left:{{item.x}}%;top:{{item.y}}%"><view class="sprite" style="background-image:url({{apiBase}}/assets/residents.png);background-position:-{{item.col*51}}px -{{item.row*51}}px"/><text>{{item.name}}</text></view></view>
  <view class="controls"><button data-action="pause" bindtap="control" disabled="{{busy}}">{{world.paused?'继续':'暂停'}}</button><button data-action="speed" bindtap="control" disabled="{{busy}}">{{world.speed}}×</button><button data-action="weather" bindtap="control" disabled="{{busy}}">{{world.weather==='sun'?'换成雨天':'换成晴天'}}</button><button data-action="advance" bindtap="control" disabled="{{busy}}">一小时后</button></view>
  <scroll-view class="people" scroll-x><view wx:for="{{world.residents}}" wx:key="id" bindtap="choose" data-id="{{item.id}}" class="person-chip {{selected===item.id?'chosen':''}}">{{item.name}}</view></scroll-view>
  <view class="profile"><view class="name">{{resident.name}}<text>{{resident.job}}</text></view><view class="tags"><text wx:for="{{resident.tags}}" wx:key="*this">{{item}}</text></view><view class="tabs"><button data-mode="now" bindtap="mode">此刻</button><button data-mode="memory" bindtap="mode">记忆 {{resident.memories.length}}</button></view><block wx:if="mode==='now'"><view class="thought">“{{resident.thought}}”</view><view class="goal">小小的心愿：{{resident.goal}}</view><view class="trust">对你的信任 {{resident.trust}} / 100</view></block><block wx:else><scroll-view class="memory" scroll-y><view wx:for="{{resident.memories}}" wx:key="eventId"><text class="sub">{{item.kind==='fact'?'经历':'印象'}} · {{item.eventId}}</text><text>{{item.text}}</text></view></scroll-view></block><view class="actions"><button data-kind="help" bindtap="interact" disabled="{{busy}}">帮个忙</button><button data-kind="invite" bindtap="interact" disabled="{{busy}}">邀请下午茶</button><button data-kind="apologize" bindtap="interact" disabled="{{busy}}">解释失约</button></view>
  <view wx:if="world.party.status==='planned'" class="party"><text>下午茶 · 16:00 · {{world.party.accepted.length}} 位居民答应</text><button data-action="attend" bindtap="control" disabled="{{busy||world.party.playerAttending}}">{{world.party.playerAttending?'已确认赴约':'我也参加'}}</button><button data-action="miss" bindtap="control" disabled="{{busy}}">这次失约，看看后来</button></view>
  <scroll-view class="chat" scroll-y scroll-top="{{chat.length*200}}"><view wx:for="{{chat}}" wx:key="index" class="message {{item.role}}"><text class="sub">{{item.role==='user'?'你':resident.name}}</text><text>{{item.content}}</text></view><text wx:if="busy">{{resident.name}}正在想怎么回答…</text></scroll-view><view class="input"><input placeholder="想说些什么？" value="{{message}}" bindinput="input" maxlength="600" disabled="{{busy}}"/><button class="primary" bindtap="interact" disabled="{{busy}}">发送</button></view></view>
  <view class="footer">日子慢慢，故事发生。</view>
 </block>
</view>
