.page{padding:32rpx 24rpx}.heading{display:flex;flex-direction:column;gap:16rpx;padding:8rpx 6rpx 30rpx}.title{font-size:38rpx;font-family:serif;letter-spacing:2rpx}.sub{font-size:21rpx;color:#9ba48e}.error{padding:20rpx;background:#f4ead4;color:#99845b;line-height:1.8}.map{width:100%;height:480rpx;position:relative;overflow:hidden;border-radius:18rpx;border:1px solid #ccd6bc}.map-image{width:100%;height:100%}.person{position:absolute;transform:translate(-50%,-70%);display:flex;flex-direction:column;align-items:center;transition:left 2s linear,top 2s linear}.sprite{width:48px;height:48px;background-size:2754px 609px;image-rendering:pixelated;transform:scale(.63);margin:-8px}.person>text{font-size:14rpx;background:#fffff0dd;padding:2rpx 6rpx;border-radius:4rpx;white-space:nowrap}.person.selected>text{background:#6e875e;color:white}.controls,.actions{display:flex;gap:10rpx;margin:18rpx 0}.controls button{flex:1;padding:0;font-size:21rpx}.people{white-space:nowrap;margin:18rpx 0 24rpx}.person-chip{display:inline-block;padding:15rpx 20rpx;border-radius:12rpx;color:#9ba88e;font-size:23rpx}.chosen{background:#e9efdc;color:#657d51}.profile{border:1px solid #e0e7d3;border-radius:20rpx;padding:30rpx;background:#fcfff7}.name{font-family:serif;font-size:40rpx}.name text{font-family:sans-serif;font-size:23rpx;color:#9aaa88;margin-left:24rpx}.tags{display:flex;gap:12rpx;margin-top:20rpx}.tags text{font-size:21rpx;background:#f0f3e9;padding:6rpx 13rpx;border-radius:7rpx;color:#8b9b7b}.tabs{display:flex;margin-top:22rpx;border-bottom:1px solid #e5ebdb}.tabs button{background:transparent;flex:1}.thought{background:#f1f5e7;border-radius:14rpx;padding:25rpx;margin-top:20rpx;line-height:1.9;font-family:serif;font-size:28rpx;color:#81926d}.goal{color:#9ba88d;font-size:23rpx;line-height:1.8;margin-top:20rpx}.trust{font-size:23rpx;color:#8da178;padding:23rpx 0}.actions button{font-size:21rpx;flex:1;padding:0}.chat{max-height:400rpx;margin-top:28rpx}.message{margin:18rpx 0;padding:20rpx;background:#f2f6e8;border-radius:12rpx;font-size:25rpx;line-height:1.8}.message text{display:block}.message.user{background:#e3ecd8}.input{display:flex;align-items:center;gap:14rpx;margin-top:25rpx}.input input{flex:1;min-width:0;font-size:24rpx;border:1px solid #dde7ce;border-radius:10rpx;padding:18rpx}.input button{font-size:23rpx}.footer{padding:30rpx 0;color:#a4b195;text-align:center;font-size:20rpx}.party{background:#f2efdc;padding:20rpx;border-radius:12rpx;margin-top:20rpx}.party text{font-size:22rpx;color:#9da281}.party button{font-size:21rpx;margin-top:14rpx}.memory{height:370rpx}.memory>view{display:flex;flex-direction:column;gap:10rpx;border-bottom:1px solid #e7eddd;padding:20rpx 0;font-size:24rpx;line-height:1.8}
